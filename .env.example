# ===================================================================
# JNANANET V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env locally. DO NOT commit .env to source control.
# ===================================================================

# SERVER CONFIGURATION
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v2
CORS_ORIGIN=http://localhost:5173

# DATABASE (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jnananet_v2?schema=public"

# SECURITY & AUTHENTICATION
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AWS SERVICES CONFIGURATION
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=jnananet-documents-dev
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# EMAIL SERVICE (Password Reset & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jnananet.team@gmail.com
SMTP_PASS=your_email_app_password
FRONTEND_RESET_BASE_URL=http://localhost:5173
